# ==============================================================================
# MYSLIP.IN — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment.

# --- Application Configuration ---
APP_NAME=MYSLIP.IN
APP_TAGLINE="Simple Billing & Accounting for Your Business"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# In production (e.g. https://myslip.in):
# Set APP_URL to your full domain URL without trailing slash
# Set APP_BASE_PATH to empty if your domain document root points to public/
# Or set APP_BASE_PATH to /myslip.in/public if running in a subfolder
APP_URL=https://myslip.in
APP_BASE_PATH=

# Session Security (true if using HTTPS)
SESSION_SECURE=true

# --- Database Credentials (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myslip_db
DB_USERNAME=root
DB_PASSWORD=
